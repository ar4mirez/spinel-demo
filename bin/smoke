#!/usr/bin/env bash
# Runs every example's smoke script, or only the examples named:
#
#   bin/smoke                          # every examples/*/smoke
#   bin/smoke quickstart wordcount-cli # just these
#   bin/smoke --list                   # the example names
#
# Each example runs in its own process; this stops at the first failure.
set -euo pipefail
cd "$(dirname "$0")/.."

all=()
for script in examples/*/smoke; do all+=("$(basename "$(dirname "$script")")"); done

if [ "${1:-}" = --list ]; then printf '%s\n' "${all[@]}"; exit 0; fi
names=("$@")
[ ${#names[@]} -gt 0 ] || names=("${all[@]}")

for name in "${names[@]}"; do
  [ -x "examples/$name/smoke" ] || { echo "smoke: no example named '$name' (try: bin/smoke --list)" >&2; exit 2; }
done
for name in "${names[@]}"; do
  printf '\n### %s\n' "$name"
  "examples/$name/smoke"
done
printf '\nall smoke checks passed: %s\n' "${names[*]}"
